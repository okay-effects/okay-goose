// A machine fn: the program stops at each choice, its rest a value — resumed for every alternative (all paths),
// and written out as bytes, to be resumed from them.

effect Choose: many { among(n: i64) -> i64; }
effect Log { log(line: u8[:]); }

let A: i64[3] = [1, 2, 3];
let B: i64[2] = [10, 20];

machine fn pick(base: i64) -> i64 ! Choose + Log {
    let a = among(3);
    log("first chosen");
    let b = among(2);
    let sum: i64 = base + A[a];
    return sum + B[b];
}

// a context: log answered in place (a tail effect)
struct Console { lines: i64 }
fn log(cx: Console&, line: u8[:]) { cx.lines += 1; }

// THE `all` HANDLER: every path's value — the rest resumed once for each alternative
recursive fn all(cx: Console&, step: Pick, out: i64[>..]&) {
    match step {
        Done d => { out.push(d.v); },
        Among c => { for i in c.n { all(cx, resume(cx, c.k, i), out); } },
    }
}

// THE `first` HANDLER: the first alternative only
fn first(cx: Console&, start: Pick) -> i64 {
    var step = start;
    loop {
        match step {
            Done d => { return d.v; },
            Among c => { step = resume(cx, c.k, 0); },
        }
    }
}

fn main() {
    var c = Console { lines: 0 };
    var out: i64[>..] = [];
    all(c, pick(c, 100), out);
    print("all: ", out, ", logged ", c.lines);
    print("first: ", first(c, pick(c, 100)));

    // the program stopped at its second choice, saved as bytes, resumed from them with the alternative 1
    var step = pick(c, 1000);
    match step { Among a => { step = resume(c, a.k, 2); }, _ => {} }
    var saved: Pick[>..] = [];
    saved.push(step);
    let bytes = saved.to_bytes();
    var back, ok = from_bytes<Pick[>..]>(bytes);
    print("saved in ", bytes.len, " bytes: ", ok, " ", back[0]);
    match back[0] { Among b => { print("resumed from the bytes: ", first(c, resume(c, b.k, 1))); }, _ => {} }
}
