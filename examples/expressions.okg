// Stops inside expressions: each taken out before its statement, left to right, innermost first — in a let, an
// if's condition, a while's (asked again at each turn), a return; a machine fn's call in an expression too.

effect Ask: once { ask(q: const u8[:]) -> i64; }   // a question: a literal, so a const slice
effect Choose: many { among(n: i64) -> i64; }

machine fn quiz() -> i64 ! Ask {
    let total: i64 = ask("a") + ask("b") * 2;
    if ask("bonus?") > 0 { return total + ask("bonus"); }
    var turns: i64 = 0;
    while ask("more?") > 0 { turns += 1; }
    return total * 100 + turns;
}

machine fn digit() -> i64 ! Choose { return among(3) + 1; }
machine fn number() -> i64 ! Choose { return digit() * 10 + digit(); }

// the answers in turn, the questions logged
handler answers for Ask(given: i64[:], at: i64&, asked: u8[>..]&) -> i64 {
    return(v) { v }
    ask(q, k) {
        asked.append(q);
        asked.push(' ');
        let a = given[at];
        at += 1;
        resume(k, a)
    }
}
handler all for Choose(out: i64[>..]&) {
    return(v) { out.push(v); }
    among(n, k) { for i in n { resume(k, i); } }
}

struct Ctx { }

fn main() {
    var c = Ctx { };
    // a = 3, b = 4: total 11; no bonus; "more?" yes, yes, no
    let given: i64[6] = [3, 4, 0, 1, 1, 0];
    var at = 0;
    var asked: u8[>..] = [];
    print("quiz: ", answers(c, quiz(c), given, at, asked), " — asked: ", asked);
    // with the bonus
    let given2: i64[4] = [3, 4, 1, 50];
    var at2 = 0;
    var asked2: u8[>..] = [];
    print("quiz with a bonus: ", answers(c, quiz(c), given2, at2, asked2), " — asked: ", asked2);
    var out: i64[>..] = [];
    all(c, number(c), out);
    print("numbers: ", out);
}
