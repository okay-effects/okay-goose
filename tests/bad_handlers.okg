effect Choose: many { among(n: i64) -> i64; flip() -> bool; }
effect Log { log(line: u8[:]); }

handler missing for Choose -> i64 {                     // no clause for flip
    return(v) { v }
    among(n, k) { resume(k, 0) }
}

handler wrong for Choose + Log -> i64 {
    return(v) { v }
    among(k) { resume(k, 0) }                           // among's argument not named
    flip(k) { resume(k, true) }
    log(line, k) { resume(k) }                          // a tail operation: the context's
}

effect Yield: once { emit(v: i64); }
handler twice for Yield {
    return() { }
    emit(v, k) { resume(k); resume(k); }                // a once rest resumed twice
}
handler looped for Yield {
    return() { }
    emit(v, k) { for i in 2 { resume(k); } }            // in a loop
}
handler kept for Yield(saved: i64&) {
    return() { }
    emit(v, k) { let copy = k; resume(k); }             // the rest used besides its resume
}
