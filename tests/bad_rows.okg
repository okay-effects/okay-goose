effect Pay { charge(user: u8[:], cents: i64) -> bool; }
effect Log { log(line: u8[:]); }
effect Stock { reserve(item: u8[:]) -> bool; }
effects Payments = Pay + Log;
effects Shop = Payments + Stock;

fn pay(user: u8[:]) -> bool ! Payments {
    let r = reserve("book");             // Stock is not in Payments
    return charge(user, 10);
}
fn checkout(user: u8[:]) -> bool ! Shop { pay(user) }
fn audit() ! Pay + Log { let ok = checkout("x"); }   // checkout needs Stock too
