effect Choose: many { among(n: i64) -> i64; }

fn plain() -> i64 ! Choose { among(2) }                 // keeps the rest: only in a machine fn

machine fn inside(flag: bool) -> i64 ! Choose {
    if flag { let x = among(2); }                       // a stop inside an if: not yet
    return 0;
}

machine fn untyped() -> i64 ! Choose {
    let half = 21;                                      // lives across the stop below, no type
    let a = among(2);
    return half + a;
}
